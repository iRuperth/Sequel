NODE_ENV=development
LOG_LEVEL=info
APP_NAME=Sequel
APP_VERSION=0.1.0

WEB_PORT=3030
API_HOST=0.0.0.0
API_PORT=4040
API_URL=http://localhost:4040
API_BASE_PATH=/api/v1
API_CORS_ORIGINS=http://localhost:3030
API_SSE_HEARTBEAT_MS=15000
API_BODY_LIMIT_BYTES=1048576

WORKER_CONCURRENCY=4
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4041
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_S=20
WORKER_SCRATCH_SWEEP_CRON=0 * * * *
WORKER_CATALOG_REFRESH_CRON=*/30 * * * *

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=sequel_superuser_dev
POSTGRES_SUPERUSER_URL=postgres://postgres:sequel_superuser_dev@localhost:55432/postgres
POSTGRES_APP_DB=sequel_app
POSTGRES_SANDBOX_DB=sequel_sandbox
POSTGRES_APP_ROLE=sequel_app
POSTGRES_APP_PASSWORD=sequel_app_dev
POSTGRES_SANDBOX_ADMIN_ROLE=sequel_sandbox_admin
POSTGRES_SANDBOX_ADMIN_PASSWORD=sequel_sandbox_admin_dev
POSTGRES_SANDBOX_READER_ROLE=sequel_sandbox_reader
POSTGRES_SANDBOX_READER_PASSWORD=sequel_sandbox_reader_dev
POSTGRES_SANDBOX_WRITER_ROLE=sequel_sandbox_writer
POSTGRES_SANDBOX_WRITER_PASSWORD=sequel_sandbox_writer_dev

DATABASE_URL=postgres://sequel_app:sequel_app_dev@localhost:55432/sequel_app
SANDBOX_DATABASE_URL=postgres://sequel_sandbox_admin:sequel_sandbox_admin_dev@localhost:55432/sequel_sandbox
SANDBOX_READER_DATABASE_URL=postgres://sequel_sandbox_reader:sequel_sandbox_reader_dev@localhost:55432/sequel_sandbox
SANDBOX_WRITER_DATABASE_URL=postgres://sequel_sandbox_writer:sequel_sandbox_writer_dev@localhost:55432/sequel_sandbox

SANDBOX_STATEMENT_TIMEOUT_MS=15000
SANDBOX_LOCK_TIMEOUT_MS=3000
SANDBOX_IDLE_TRANSACTION_TIMEOUT_MS=30000
SANDBOX_WORK_MEM=32MB
SANDBOX_TEMP_FILE_LIMIT=512MB
SANDBOX_CONNECTION_LIMIT=20
SANDBOX_MAX_ROWS=10000
SANDBOX_FETCH_CHUNK=500
SANDBOX_MAX_RESULT_BYTES=10485760
SANDBOX_MAX_CELL_CHARS=2000
SANDBOX_MAX_STATEMENTS_PER_RUN=20
SANDBOX_POOL_SIZE=5
SANDBOX_CANCEL_GRACE_MS=2000
SANDBOX_SCRATCH_TTL_HOURS=72
SANDBOX_TIMEZONE=UTC

REDIS_IMAGE=redis:7-alpine
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_OUTPUT_TOKENS=16000
LLM_EFFORT=high
LLM_FEEDBACK_ENABLED=true
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=2

TASK_GENERATION_MAX_ATTEMPTS=3
TASK_REFERENCE_MAX_ROWS=500
TASK_REFERENCE_STORE_ROWS=200
TASK_STARTER_DATASET_SLUG=fintech
TASK_STARTER_TASK_COUNT=5
TASK_TICKET_PREFIX=DATA

GRADER_STATEMENT_TIMEOUT_MS=20000
GRADER_NUMERIC_SCALE=4
GRADER_SAMPLE_DIFF_ROWS=5

SCHEMA_CACHE_TTL_S=300
DASHBOARD_CACHE_TTL_S=60
JOB_RETENTION_COUNT=500
JOB_POLL_INTERVAL_MS=2000

LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_USER_HANDLE=local
LOCAL_USER_DISPLAY_NAME=Terriermon
LOCAL_USER_ROLE_TITLE=Data Engineer

DATASET_SEED=20260101
DATASET_AS_OF_DATE=2026-06-30
DATASET_SCALE=1
